{
  "name": "@ganttkit/monorepo",
  "version": "0.1.2",
  "author": "dchar",
  "description": "GanttKit - a headless, framework-agnostic Gantt chart engine for JavaScript and TypeScript, with SVG, HTML and canvas renderers and Vue, React, Angular and Nuxt bindings.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "ganttkit",
    "project-management",
    "timeline",
    "scheduling",
    "headless",
    "framework-agnostic",
    "typescript",
    "javascript",
    "monorepo",
    "svg",
    "canvas",
    "vue",
    "react",
    "angular",
    "nuxt"
  ],
  "homepage": "https://ganttkit.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragoneel/ganttkit.git"
  },
  "bugs": {
    "url": "https://github.com/Dragoneel/ganttkit/issues"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "dev": "pnpm -r --parallel --filter \"./packages/*\" run dev",
    "test": "pnpm -r --filter \"./packages/*\" run test",
    "test:coverage": "pnpm -r --filter \"./packages/*\" run test -- --coverage",
    "typecheck": "pnpm -r --filter \"./packages/*\" run typecheck",
    "lint": "eslint .",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "clean": "pnpm -r exec rimraf dist node_modules/.cache && rimraf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.8"
  },
  "pnpm": {
    "overrides": {
      "human-id": "^1.0.2"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@angular/build>vitest": "*"
      }
    }
  }
}
