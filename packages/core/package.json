{
  "name": "@ganttkit/core",
  "version": "0.2.0",
  "author": "dchar",
  "description": "Headless, framework-agnostic Gantt chart engine for JavaScript and TypeScript, with a plugin host and zero runtime dependencies.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "ganttkit",
    "project-management",
    "timeline",
    "scheduling",
    "headless",
    "framework-agnostic",
    "typescript",
    "javascript",
    "plugin",
    "engine",
    "task-management",
    "virtualization"
  ],
  "homepage": "https://ganttkit.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragoneel/ganttkit.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/Dragoneel/ganttkit/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
