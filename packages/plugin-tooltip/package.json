{
  "name": "@ganttkit/plugin-tooltip",
  "version": "0.1.2",
  "author": "dchar",
  "description": "Hover tooltip card for GanttKit Gantt chart tasks.",
  "keywords": [
    "gantt",
    "gantt-chart",
    "ganttkit",
    "project-management",
    "timeline",
    "scheduling",
    "plugin",
    "tooltip",
    "hover",
    "popover",
    "ui"
  ],
  "homepage": "https://ganttkit.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragoneel/ganttkit.git",
    "directory": "packages/plugin-tooltip"
  },
  "bugs": {
    "url": "https://github.com/Dragoneel/ganttkit/issues"
  },
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "@ganttkit/core": "workspace:*"
  },
  "devDependencies": {
    "@ganttkit/core": "workspace:*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
