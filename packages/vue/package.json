{
  "name": "@ganttkit/vue",
  "version": "0.1.2",
  "author": "dchar",
  "description": "Vue 3 renderer plugin for GanttKit - a <GanttChart> component over the HTML renderer.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dragoneel/ganttkit.git",
    "directory": "packages/vue"
  },
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "@ganttkit/svg": "workspace:*",
    "@ganttkit/canvas": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@ganttkit/svg": {
      "optional": true
    },
    "@ganttkit/canvas": {
      "optional": true
    }
  },
  "dependencies": {
    "@ganttkit/core": "workspace:*",
    "@ganttkit/html": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.42"
  }
}
